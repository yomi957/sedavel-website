# Public project identifiers only. These values reach the browser.
# Copy to .env.local and set the Project ID of Sedavel Website CMS.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Never put API tokens or passwords in NEXT_PUBLIC_ variables.
# Studio uses the signed-in editor session; no write token is needed.

# Optional, server-only: Viewer token only if production is a private dataset.
# Set this in .env.local or server hosting secrets, never send it in chat.
# SANITY_API_READ_TOKEN=

# Server-only Viewer token for authorized Home Hero draft preview. Never NEXT_PUBLIC_.
# SANITY_API_READ_TOKEN=
# Standalone Studio: configure only after a real preview frontend is deployed.
# SANITY_STUDIO_PREVIEW_ORIGIN=https://preview.sedavel.com
# Local embedded Studio uses http://localhost:3000 without this variable.
